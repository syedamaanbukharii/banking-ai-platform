# =============================================================================
# Banking AI Platform - example environment file
# Copy to `.env` and adjust. NEVER commit a real `.env`. NEVER put real secrets
# here. All secrets are injected at runtime (env, Docker/K8s secrets, vault).
# =============================================================================

# --- App ---
APP_ENV=local                       # local | staging | production
APP_NAME="Banking AI Platform"
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO                  # DEBUG | INFO | WARNING | ERROR
APP_LOG_JSON=true                   # structured JSON logs
APP_CORS_ORIGINS=http://localhost:3000

# --- Security / Auth ---
# Dev-only secret. In staging/production this MUST be provided by the secret
# manager and the app refuses to start with this placeholder when APP_ENV!=local.
SECURITY_JWT_SECRET=dev-only-change-me-please-32+chars-long-string
SECURITY_JWT_ALGORITHM=HS256
SECURITY_ACCESS_TOKEN_TTL_SECONDS=900          # 15 minutes
SECURITY_REFRESH_TOKEN_TTL_SECONDS=1209600     # 14 days
SECURITY_COOKIE_SECURE=false                   # set true behind HTTPS
SECURITY_COOKIE_DOMAIN=localhost
SECURITY_RATE_LIMIT_PER_MINUTE=120

# Keycloak / OIDC (used when SECURITY_AUTH_MODE=oidc). The built-in local auth
# mode (default) issues its own JWTs so the platform is runnable without Keycloak.
SECURITY_AUTH_MODE=local                        # local | oidc
OIDC_ISSUER=http://localhost:8080/realms/banking
OIDC_CLIENT_ID=banking-ai-backend
OIDC_CLIENT_SECRET=                              # injected at runtime, never committed
OIDC_JWKS_URL=http://localhost:8080/realms/banking/protocol/openid-connect/certs

# --- Database ---
# Local docker-compose uses Postgres. Tests use an in-memory SQLite URL set by
# the test harness, so no Postgres is required to run the suite.
DATABASE_URL=postgresql+asyncpg://banking:banking@localhost:5432/banking
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_ECHO=false

# --- Redis (cache / rate-limit / ephemeral state) ---
REDIS_URL=redis://localhost:6379/0

# --- Object storage (MinIO locally, S3 in prod) ---
STORAGE_ENDPOINT_URL=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=banking-documents
STORAGE_ACCESS_KEY=minioadmin                    # dev only
STORAGE_SECRET_KEY=minioadmin                    # dev only
STORAGE_USE_LOCAL_FS=true                        # true -> store under ./.localstorage for dev/tests

# --- Vector store ---
VECTOR_BACKEND=memory                            # memory | pgvector
VECTOR_DIMENSIONS=384

# --- LLM model router ---
# Online primary: Groq. Offline fallback: local Gemma-compatible server.
LLM_ROUTER_POLICY=prefer_online                  # prefer_online | offline_only | online_only
LLM_PRIMARY_PROVIDER=groq
LLM_FALLBACK_PROVIDER=local_gemma
LLM_REQUEST_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

GROQ_API_KEY=                                    # injected at runtime, never committed
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.1-8b-instant

LOCAL_GEMMA_BASE_URL=http://localhost:11434/v1   # e.g. an Ollama/vLLM OpenAI-compatible endpoint
LOCAL_GEMMA_MODEL=gemma2:9b

# --- Workflow engine ---
WORKFLOW_BACKEND=inprocess                        # inprocess | temporal
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=banking-ai

# --- Observability ---
OTEL_ENABLED=false
METRICS_ENABLED=true

# --- Dev seed (local only) ---
SEED_ADMIN_EMAIL=admin@local.dev
SEED_ADMIN_PASSWORD=Admin123!Local
